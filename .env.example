# Background removal — server-side Cloud Run proxy.
# NOT NEXT_PUBLIC_: these must stay on the server. A NEXT_PUBLIC_ variable is
# inlined into the client bundle at build time, which would publish the token to
# every visitor. See src/app/api/remove-bg/route.ts
BG_REMOVE_URL=https://your-cloud-run-service.run.app/api/remove-bg
BG_REMOVE_TOKEN=your_bg_remove_token_here

# Optional: route the agent through a parent system's gateway instead of the
# user's own API key. When set, the browser POSTs to this URL instead of calling
# the provider directly. See docs/agent-gateway.md
# NEXT_PUBLIC_AGENT_GATEWAY_URL=

# No provider API key belongs here. Users supply their own Gemini key in the
# Assistant panel; it is stored in their browser and sent only to Google.
